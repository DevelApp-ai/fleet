#!/usr/bin/env bash
# pre-push: run scripts/check-public.sh on every commit the push would publish.
# Install with `make hooks`. Bypass (not recommended): git push --no-verify.
set -euo pipefail
remote=$1
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ $local_sha == "$zero" ]] && continue # deleting a ref
  case $remote_ref in
    refs/heads/private/* | refs/tags/private/*) echo "pre-push: refusing to push $remote_ref" >&2; status=1; continue ;;
  esac
  if [[ $remote_sha == "$zero" ]]; then
    range=("$local_sha" --not "--remotes=$remote")
  else
    range=("$remote_sha..$local_sha")
  fi
  scripts/check-public.sh "${range[@]}" || status=1
done
exit $status
